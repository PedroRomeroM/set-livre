{
  "name": "@set-livre/web",
  "version": "0.0.0",
  "private": true,
  "description": "Marketplace web de aluguel de estúdios audiovisuais.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "24.18.0"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/local-setup.mjs dev-web",
    "dev:backoffice": "node scripts/local-setup.mjs dev-backoffice",
    "build": "npm run build:web && npm run build:backoffice",
    "build:web": "node scripts/local-setup.mjs build-web",
    "build:backoffice": "npm run build --workspace @set-livre/backoffice",
    "start": "node scripts/local-setup.mjs start-web",
    "start:backoffice": "node scripts/local-setup.mjs start-backoffice",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:web && npm run typecheck:edge && npm run typecheck --workspaces --if-present && npm run typecheck:tests",
    "typecheck:edge": "deno check --frozen --config supabase/functions/media-cleanup/deno.json supabase/functions/media-cleanup/index.ts",
    "typecheck:web": "next typegen && tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "supabase:start": "node scripts/local-setup.mjs start",
    "supabase:stop": "node scripts/local-setup.mjs stop",
    "supabase:status": "node scripts/local-setup.mjs status",
    "supabase:reset": "node scripts/local-setup.mjs reset",
    "supabase:lint": "node scripts/local-setup.mjs lint",
    "supabase:schema": "node scripts/local-setup.mjs generate-schema",
    "supabase:types": "node scripts/local-setup.mjs generate-types",
    "supabase:generate": "node scripts/local-setup.mjs generate",
    "test:db": "node scripts/local-setup.mjs test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e": "playwright test",
    "test:e2e:affected": "playwright test",
    "test:e2e:critical": "playwright test tests/e2e/critical",
    "test:a11y": "playwright test --grep @a11y",
    "docs:check": "node scripts/docs-check.mjs",
    "migrations:check": "node scripts/migration-guard.mjs",
    "local:setup": "node scripts/local-setup.mjs reset",
    "production:preflight": "node scripts/provision-production-role.mjs --preflight",
    "production:role": "node scripts/provision-production-role.mjs",
    "production:media-cleanup": "node scripts/configure-production-media-cleanup.mjs",
    "release": "node scripts/release.mjs",
    "audit": "npm audit --audit-level=high",
    "knip": "knip"
  },
  "dependencies": {
    "@set-livre/contracts": "0.0.0",
    "@set-livre/ui": "0.0.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/storage-js": "2.112.3",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "deno": "2.9.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
