[Unit]
Description=Set Livre backoffice
After=network-online.target
Wants=network-online.target
Requires=set-livre-release-recovery@link.service
After=set-livre-release-recovery@link.service
ConditionPathExists=/opt/set-livre/current/backoffice/apps/backoffice/server.js
ConditionPathExists=/etc/set-livre/host-config.sha256
ConditionPathExists=!/etc/set-livre/bootstrap-in-progress.sha256
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=setlivre-backoffice
Group=setlivre-backoffice
SupplementaryGroups=setlivre
WorkingDirectory=/opt/set-livre/current/backoffice
Environment=NODE_ENV=production
Environment=NODE_EXTRA_CA_CERTS=/etc/set-livre/supabase-root-2021-ca.crt
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
EnvironmentFile=/opt/set-livre/current/.runtime/backoffice.env
EnvironmentFile=/opt/set-livre/current/.runtime/release.env
ExecStartPre=/usr/bin/test -f /opt/set-livre/current/backoffice/apps/backoffice/server.js
ExecStart=/opt/node/bin/node apps/backoffice/server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
