[Unit]
Description=Set Livre production media cleanup
After=network-online.target set-livre-release-recovery.service
Wants=network-online.target
AssertPathIsSymbolicLink=/opt/set-livre/current
AssertPathExists=/opt/set-livre/current/web/runtime/invoke-media-cleanup.mjs
AssertPathExists=/opt/set-livre/current/.runtime/web.env
AssertPathExists=/opt/set-livre/current/.runtime/release.env
AssertPathExists=!/etc/set-livre/bootstrap-in-progress.sha256
AssertPathExists=!/etc/set-livre/bootstrap-recovery-in-progress.sha256

[Service]
Type=oneshot
User=setlivre-web
Group=setlivre-web
SupplementaryGroups=setlivre
WorkingDirectory=/opt/set-livre/current/web
Environment=NODE_ENV=production
EnvironmentFile=/opt/set-livre/current/.runtime/web.env
EnvironmentFile=/opt/set-livre/current/.runtime/release.env
ExecStart=/opt/node/bin/node /opt/set-livre/current/web/runtime/invoke-media-cleanup.mjs
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
