[Unit]
Description=Start Set Livre applications after recovery and initial media cleanup
Requires=set-livre-release-recovery.service
After=set-livre-release-recovery.service
AssertPathExists=!/etc/set-livre/bootstrap-in-progress.sha256
AssertPathExists=!/etc/set-livre/bootstrap-recovery-in-progress.sha256

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start set-livre-media-cleanup.service
ExecStart=/usr/bin/systemctl start set-livre-web.service set-livre-backoffice.service
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
